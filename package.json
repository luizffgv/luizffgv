{
  "name": "website",
  "version": "0.1.0",
  "dependencies": {
    "@luizffgv/ekranoplan": "^0.0.0-experimental.0",
    "@mantine/hooks": "^8.3.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@sindresorhus/string-hash": "^2.0.0",
    "class-variance-authority": "^0.7.1",
